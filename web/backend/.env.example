# ── Servidor ──────────────────────────────
PORT=3000
NODE_ENV=development

# ── Base de Datos (PostgreSQL) ─────────────
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/localmarket

# ── JWT ────────────────────────────────────
# Genera secrets con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_clave_muy_larga_y_segura_minimo_64_chars
JWT_EXPIRES_IN=15m
REFRESH_SECRET=otra_clave_muy_larga_para_refresh_tokens_diferente_a_la_anterior
REFRESH_EXPIRES_IN=30d

# ── Google OAuth 2.0 ───────────────────────
# Crear en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ── Email (SMTP) ───────────────────────────
# Gmail: usa contraseña de aplicación (no tu contraseña normal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=contraseña_de_aplicacion_gmail
EMAIL_FROM=LocalMarket <noreply@localmarket.com>

# ── URLs ───────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Cloudinary (imágenes) ─────────────────
# Crear cuenta en https://cloudinary.com (plan gratuito disponible)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
