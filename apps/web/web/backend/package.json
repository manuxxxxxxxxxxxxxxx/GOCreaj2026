{
  "name": "localmarket-backend",
  "version": "1.0.0",
  "description": "LocalMarket REST API — Node.js + Express + PostgreSQL",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "migrate": "psql $DATABASE_URL -f migrations/001_schema.sql && psql $DATABASE_URL -f migrations/002_master_admin_terms.sql && psql $DATABASE_URL -f migrations/003_indexes_messages_cleanup.sql",
    "migrate:win": "psql %DATABASE_URL% -f migrations/001_schema.sql & psql %DATABASE_URL% -f migrations/002_master_admin_terms.sql & psql %DATABASE_URL% -f migrations/003_indexes_messages_cleanup.sql",
    "migrate:001": "psql $DATABASE_URL -f migrations/001_schema.sql",
    "migrate:002": "psql $DATABASE_URL -f migrations/002_master_admin_terms.sql",
    "migrate:003": "psql $DATABASE_URL -f migrations/003_indexes_messages_cleanup.sql",
    "db:cleanup": "psql $DATABASE_URL -c \"SELECT cleanup_expired_tokens();\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.7",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.4",
    "@types/nodemailer": "^6.4.14",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.14",
    "@types/passport-jwt": "^3.0.13",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
