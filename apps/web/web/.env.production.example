# Variables de entorno para configurar en Vercel (Project Settings → Environment Variables),
# NO se suben al repo. Copiar los valores reales ahí, no en este archivo.

# URL pública del backend PHP desplegado en Railway, ej: https://svgo-backend.up.railway.app
VITE_API_URL=

# Mismo Google OAuth Client ID que ya usa el proyecto (ver ../mobile/frontend/GOOGLE_AUTH_SETUP.md).
# Hay que agregar el dominio de Vercel a "Authorized JavaScript origins" en Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=195559019978-sqfadh1srban3akat11eiko3hpciq6pv.apps.googleusercontent.com
