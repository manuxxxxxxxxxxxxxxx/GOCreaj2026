# Configuración para red local -- esta IP es la de la PC en la red Wi-Fi (ver
# "Wi-Fi" en ipconfig/Get-NetIPAddress, NO la de Ethernet). Si cambia de red o de
# router, hay que actualizarla acá otra vez.
EXPO_PUBLIC_API_URL=http://192.168.0.11/GOCreaj2026/apps/mobile/backend
EXPO_PUBLIC_SOCKET_URL=http://192.168.0.11:3001
EXPO_PUBLIC_WEB_URL=http://192.168.0.11:5173

# Fuerza la IP LAN correcta en el QR de Expo
REACT_NATIVE_PACKAGER_HOSTNAME=192.168.0.11

# Login con Google (ver GOOGLE_AUTH_SETUP.md)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=195559019978-sqfadh1srban3akat11eiko3hpciq6pv.apps.googleusercontent.com
